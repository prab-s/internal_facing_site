DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
POSTGRES_DB=fan_graphs
POSTGRES_USER=fan_graphs_user
POSTGRES_PASSWORD=change_me
APP_TIMEZONE=Pacific/Auckland
TZ=Pacific/Auckland

# Quote request notifications (comma-separated; leave blank until configured)
QUOTE_REQUEST_RECIPIENT_EMAILS=

# Quote/enquiry throttling
QUOTE_REQUEST_THROTTLE_WINDOW_SECONDS=900
QUOTE_REQUEST_THROTTLE_MAX_ATTEMPTS=3

# SMTP delivery (leave blank until the client's catalogue mailbox is available)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Optional explicit mode: starttls, ssl, or none. Defaults to SMTP_USE_TLS for compatibility.
SMTP_SECURITY=starttls
SMTP_FROM_ADDRESS=
